{
  "name": "big-log-viewer",
  "displayName": "%ext.displayName%",
  "description": "%ext.description%",
  "version": "1.3.5",
  "license": "MIT",
  "publisher": "wake",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/uwakeme/large_log_check"
  },
  "keywords": [
    "log",
    "log viewer",
    "open log viewer",
    "large file",
    "log analysis",
    "日志",
    "日志查看",
    "大日志",
    "Java日志",
    "日志分析"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Formatters"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "big-log-viewer.openLogFile",
        "title": "%cmd.openLogFile.title%",
        "category": "%cmd.category%"
      },
      {
        "command": "big-log-viewer.deleteByTime",
        "title": "%cmd.deleteByTime.title%",
        "category": "%cmd.category%"
      },
      {
        "command": "big-log-viewer.deleteByLine",
        "title": "%cmd.deleteByLine.title%",
        "category": "%cmd.category%"
      },
      {
        "command": "big-log-viewer.refresh",
        "title": "%cmd.refresh.title%",
        "category": "%cmd.category%"
      },
      {
        "command": "big-log-viewer.showStatistics",
        "title": "%cmd.showStatistics.title%",
        "category": "%cmd.category%"
      },
      {
        "command": "big-log-viewer.toggleBookmarks",
        "title": "%cmd.toggleBookmarks.title%",
        "category": "%cmd.category%"
      },
      {
        "command": "big-log-viewer.toggleComments",
        "title": "%cmd.toggleComments.title%",
        "category": "%cmd.category%"
      },
      {
        "command": "big-log-viewer.jumpToLine",
        "title": "%cmd.jumpToLine.title%",
        "category": "%cmd.category%"
      },
      {
        "command": "big-log-viewer.showAdvancedSearch",
        "title": "%cmd.showAdvancedSearch.title%",
        "category": "%cmd.category%"
      },
      {
        "command": "big-log-viewer.showInvestigationTemplates",
        "title": "%cmd.showInvestigationTemplates.title%",
        "category": "%cmd.category%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname == .log || resourceExtname == .txt",
          "command": "big-log-viewer.openLogFile",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "when": "resourceExtname == .log || resourceExtname == .txt",
          "command": "big-log-viewer.openLogFile",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "big-log-viewer.search.debounceMs": {
          "type": "number",
          "default": 400,
          "minimum": 0,
          "description": "%config.search.debounceMs.description%"
        },
        "big-log-viewer.collapse.minRepeatCount": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "description": "%config.collapse.minRepeatCount.description%"
        },
        "big-log-viewer.timeline.samplePoints": {
          "type": "number",
          "default": 200,
          "minimum": 20,
          "maximum": 1000,
          "description": "%config.timeline.samplePoints.description%"
        },
        "big-log-viewer.theme": {
          "type": "string",
          "enum": [
            "default",
            "neon",
            "aurora",
            "holo"
          ],
          "default": "default",
          "enumDescriptions": [
            "%config.theme.enumDescription.0%",
            "%config.theme.enumDescription.1%",
            "%config.theme.enumDescription.2%",
            "%config.theme.enumDescription.3%"
          ],
          "description": "%config.theme.description%"
        },
        "big-log-viewer.level.aliases": {
          "type": "object",
          "default": {
            "ERROR": [
              "E",
              "F",
              "ERR"
            ],
            "WARN": [
              "W",
              "WRN"
            ],
            "INFO": [
              "I",
              "INF"
            ],
            "DEBUG": [
              "D",
              "T",
              "V",
              "DBG",
              "TRC"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "%config.level.aliases.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run lint && npm run compile && npm test",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/*.test.cjs",
    "lint": "eslint src --ext ts",
    "build": "npm run compile",
    "dev": "npm run watch",
    "clean": "rimraf out",
    "rebuild": "npm run clean; npm run compile",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.44"
  }
}
